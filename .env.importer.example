# Ключи брать в основном аккаунте владельца — том, где лежат оба проекта Supabase
# (карта аккаунтов и доступов: docs/INFRA_ACCOUNTS.md).
# Ключи проекта переезд между организациями не меняет, а вот Personal Access Token —
# это доступ уровня АККАУНТА: после переезда старый токен отдаёт 403, нужен новый.

# Inspector X (service role — пишет в БД)
IX_SUPABASE_URL="https://kcjlrvgjtoefqgzxuizz.supabase.co"
IX_SUPABASE_SERVICE_KEY="sb_secret_..."
# JurisBase lexportal (read-only)
JB_SUPABASE_URL="https://<jurisbase-project>.supabase.co"
JB_SUPABASE_KEY="sb_publishable_..."
# Management API (миграции, настройки проекта) — Personal Access Token основного аккаунта
SUPABASE_ACCESS_TOKEN="sbp_..."

# LegalX live-клиент (importer/build/legalx_live.py, Задача 42): нужны только при
# LEGALX_BACKEND=live — по умолчанию (или mock) конвейер работает на фикстурах
# importer/build/legalx_mock.py и эти три переменные не читаются.
LEGALX_BACKEND="mock"  # mock (по умолчанию) | live
# PostgREST-адрес проекта LegalX (тот же паттерн, что JB_SUPABASE_URL — другой проект)
LEGALX_SUPABASE_URL="https://<legalx-project>.supabase.co"
# read-only роль (не service key!) — воркер InspectorX только читает LegalX (ADR-0005)
LEGALX_SUPABASE_KEY="sb_publishable_..."

# Живой LLM-раннер Build-конвейера и мониторинга (importer/build/llm_live.py, Волна 2):
# ключ читает сам Anthropic SDK из окружения, .env отдельно не парсится.
ANTHROPIC_API_KEY="sk-ant-..."
# Потолок вызовов модели на процесс — страховка от разгона цикла (не денежный лимит;
# расход по факту — `python -m importer build cost --run <id>`). Пусто/не число = 400 по умолчанию.
IMPORTER_LLM_MAX_CALLS="400"

# Дополнительные LLM-провайдеры (OpenAI-совместимые). Имя после LLM_PROVIDER_ —
# то же, что в models.yaml: providers (верхним регистром). Примеры:
# LLM_PROVIDER_GEMINI_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# LLM_PROVIDER_GEMINI_KEY="AIza..."
# LLM_PROVIDER_OPENROUTER_URL="https://openrouter.ai/api/v1"
# LLM_PROVIDER_OPENROUTER_KEY="sk-or-..."
# LLM_PROVIDER_ZRO_URL="https://zro.moonmath.ai/v1"
# LLM_PROVIDER_ZRO_KEY="..."
# Подмена модели тира на время процесса (eval разных моделей без правки yaml):
# IMPORTER_TIER_CHEAP="gemini-3.1-flash-lite"
# IMPORTER_TIER_MID="deepseek-v4.1-flash"
# IMPORTER_TIER_EXPENSIVE="claude-sonnet-5"
