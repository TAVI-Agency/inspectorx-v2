# Ключи брать в основном аккаунте владельца — том, где лежат оба проекта Supabase
# (карта аккаунтов и доступов: docs/INFRA_ACCOUNTS.md).
# Ключи проекта переезд между организациями не меняет, а вот Personal Access Token —
# это доступ уровня АККАУНТА: после переезда старый токен отдаёт 403, нужен новый.

# Inspector X (service role — пишет в БД)
IX_SUPABASE_URL="https://kcjlrvgjtoefqgzxuizz.supabase.co"
IX_SUPABASE_SERVICE_KEY="sb_secret_..."
# JurisBase lexportal (read-only)
JB_SUPABASE_URL="https://<jurisbase-project>.supabase.co"
JB_SUPABASE_KEY="sb_publishable_..."
# Management API (миграции, настройки проекта) — Personal Access Token основного аккаунта
SUPABASE_ACCESS_TOKEN="sbp_..."
